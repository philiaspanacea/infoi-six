// if you put the .value in the const, it will not work because you are getting the value while the const is empty. Only use .value when you need it since it takes a snapshot of the value in that instance. 

const userEle = document.getElementById("username");
const passWord = document.getElementById("password");
const submitBtn = document.getElementById("submit");
const result = document.getElementById("result");

// ()=> and function() work the same, but ()=> works better majority of the time.
// 1 equal sign means assigning a value, 2 equal signs will accept value and type (integer 2 and string 2), 3 equal signs will only accept the exact value and type (only string 2 or integer 2).

submitBtn.addEventListener("click", ()=> {
    const checker = false;
    // && checks if another value is true. It will only work if BOTH are true. If one is false, it will go to else.
    // || checks if one or the other value is true. It will work if just one is true.

    if(userEle.value === "potato" || passWord.value === "password"){
        result.innerHTML = "You are now logged in!";
    }
    else{
        result.innerHTML = "Username is incorrect!";
    }

    // adding another if creates a new question separate from the previous.

    if(userEle.value === userEle.value.toUpperCase()){
        console.log("uppercase")
    }

    //else doesn't need a condition like if (-----), elseif does, and acts as a question within your question.

    else if(userEle.value === userEle.value.toLowerCase()){
        console.log("lowercase")
    }
    else {
        console.log("mixed")
    }
    
    // result.innerHTML = userEle.value + passWord.value;
})